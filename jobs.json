{
 "parallel": 3,
 "jobs": [
  {
   "id": "cord-data",
   "cmd": "python -m docext.prepare cord --out data",
   "creates": "data/cord/train.pkl"
  },
  {
   "id": "cord-split",
   "cmd": "python -m docext.prepare cord-disjoint --out data",
   "needs": [
    "cord-data"
   ],
   "creates": "data/cord_disjoint/train.pkl"
  },
  {
   "id": "cord-analyse",
   "cmd": "python -m docext.analyse data/cord/train.pkl --model layoutlmv3",
   "needs": [
    "cord-split"
   ]
  },
  {
   "id": "wr-data",
   "cmd": "bash scripts/get_wildreceipt.sh",
   "creates": "data/wildreceipt/train.pkl"
  },
  {
   "id": "wr-analyse",
   "cmd": "python -m docext.analyse data/wildreceipt/train.pkl --model layoutlmv3",
   "needs": [
    "wr-data"
   ]
  },
  {
   "id": "docile-data",
   "cmd": "bash scripts/get_docile.sh",
   "creates": "data/docile/val.pkl",
   "rev": 1
  },
  {
   "id": "docile-analyse",
   "cmd": "python -m docext.analyse data/docile/train.pkl --model layoutlmv3",
   "needs": [
    "docile-data"
   ]
  },
  {
   "id": "wr-calibrate",
   "cmd": "python -m docext.split data/wildreceipt --train train validation --test test",
   "needs": [
    "wr-data"
   ]
  },
  {
   "id": "cord-calibrate",
   "cmd": "python -m docext.split data/cord --test test",
   "needs": [
    "cord-data"
   ]
  },
  {
   "id": "cord_layoutlmv3_j0.0_k0.0_a0.0_c0.0_s0",
   "cmd": "python -m docext.train --data data/cord --eval-splits validation test --seed 0",
   "needs": [
    "cord-split"
   ]
  },
  {
   "id": "cord_layoutlmv3_j0.0_k0.0_a0.0_c0.0_s1",
   "cmd": "python -m docext.train --data data/cord --eval-splits validation test --seed 1",
   "needs": [
    "cord-split"
   ]
  },
  {
   "id": "cord_layoutlmv3_j0.0_k0.0_a0.0_c0.0_s2",
   "cmd": "python -m docext.train --data data/cord --eval-splits validation test --seed 2",
   "needs": [
    "cord-split"
   ]
  },
  {
   "id": "cord_roberta_j0.0_k0.0_a0.0_c0.0_s0",
   "cmd": "python -m docext.train --data data/cord --eval-splits validation test --model roberta",
   "needs": [
    "cord-split"
   ]
  },
  {
   "id": "cord_bros_j0.0_k0.0_a0.0_c0.0_s0",
   "cmd": "python -m docext.train --data data/cord --eval-splits validation test --model bros",
   "needs": [
    "cord-split"
   ]
  },
  {
   "id": "route-cord_layoutlmv3_j0.0_k0.0_a0.0_c0.0_s0",
   "cmd": "python -m docext.routing runs/cord_layoutlmv3_j0.0_k0.0_a0.0_c0.0_s0 --split test --target 0.95",
   "needs": [
    "cord_layoutlmv3_j0.0_k0.0_a0.0_c0.0_s0"
   ]
  },
  {
   "id": "docile_layoutlmv3_j0.0_k0.0_a0.0_c0.0_s0",
   "cmd": "python -m docext.train --data data/docile --eval-splits val --epochs 6",
   "needs": [
    "docile-data"
   ]
  }
 ]
}